 "director": {
  "_note": "Generic counter rules: a CONDITION on what the player has / does -> a re-weighting of enemy kinds, with a message. The engine evaluates them; it does not know what they mean.",
  "power": {
   "weapon_tier": 1,
   "deployable": 3,
   "build_each": 0.4,
   "build_cap": 30,
