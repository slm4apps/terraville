   "height_bonus": 2
  },
  "rules": [
   {
    "when": "height_over",
    "value": 2.2,
    "weight": {
     "climber": 4,
     "spitter": 3
    },
    "say": "you are up high: climbers and spitters"
   },
   {
    "when": "has_role",
    "value": "deployable",
    "weight": {
     "breaker": 3,
     "tank": 2
    },
    "say": "deployables: breakers hunt them"
   },
   {
    "when": "has_shape",
    "value": "wall",
    "weight": {
     "breaker": 2,
     "tank": 2
    },
    "say": "walls: tanks come to smash them"
   },
   {
    "when": "weapons_at_least",
    "value": 2,
    "weight": {
     "runner": 2.5
    },
    "say": "strong guns: runners rush you"
   },
   {
    "when": "has_item",
    "value": "mine",
    "weight": {
     "crawler": 2
    },
    "say": "mines: crawlers slip in low"
   },
   {
    "when": "no_ranged_weapon",
    "value": 0,
    "weight": {
     "spitter": 2
    }
   }
  ]
 },
